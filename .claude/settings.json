{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run type-check)",
      "Bash(npm test)",
      "Bash(npm run test:*)",
      "Bash(npm run upstream:check)",
      "Bash(npm run upstream:fetch)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx eslint:*)",
      "Bash(npx vitest run:*)",
      "Bash(npx expo export:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git -C upstream log:*)",
      "Bash(git -C upstream show:*)"
    ]
  }
}
