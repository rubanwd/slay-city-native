# Copy to .env and fill in the shared Supabase project's values.
# Both apps point at the same project — see docs/ARCHITECTURE.md §"Supabase ownership".
# EXPO_PUBLIC_* vars are inlined by Metro at build time; never put a secret behind this prefix.
# The anon key is public by design (AGENTS.md) and is the only Supabase key allowed here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
