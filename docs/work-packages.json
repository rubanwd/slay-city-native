  "open_decisions": [
    {
      "id": "OD-1",
      "question": "Move OpenRouter calls from Server Actions to Supabase Edge Functions",
      "recommended": "yes",
      "blocks": [
        "M4",
        "WP-5.6"
      ]
    },
    {
      "id": "OD-2",
      "question": "Implement Sign in with Apple",
      "recommended": "yes",
      "blocks": [
        "M2",
        "WP-2.5",
        "M7"
      ]
    },
    {
      "id": "OD-3",
      "question": "Enter the Apple Kids Category",
      "recommended": "no — rate 4+",
      "blocks": [
        "WP-7.5"
      ]
    },
    {
      "id": "OD-4",
      "question": "Keep Google Analytics on mobile",
      "recommended": "keep, unless OD-3 is yes",
      "blocks": [
