{
  "expo": {
    "name": "SLAY CITY",
    "slug": "slay-city",
    "scheme": "slaycity",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#111111",
    "icon": "./assets/icons/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.slaycity.mobile"
    },
    "android": {
      "package": "app.slaycity.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#111111",
        "foregroundImage": "./assets/icons/android-icon-foreground.png",
        "monochromeImage": "./assets/icons/android-icon-monochrome.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-audio",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#111111"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    }
  }
}
